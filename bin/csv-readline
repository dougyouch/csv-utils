#!/usr/bin/env ruby
# frozen_string_literal: true

require 'optparse'

require 'csv-utils'

def strip_byte_order_mark(line)
  CSVUtils::ByteOrderMark.strip(line)
end

# Splits a raw line on commas, flagging columns with a quote CSV would reject, so a malformed line can be read.
class LineParser
  def initialize(line)
    @line = line
    @columns = []
    @opened_quote = false
    @pos = -1
    @last_comma_pos = -1
  end

  # @return [Array<Array(String, Symbol)>] each column's raw value and :ok or :stray_quote
  def parse
    while (@pos = @line.index(/[",\n]/, @pos + 1))
      @line[@pos] == '"' ? quote : separator
    end
    @columns
  end

  private

  def quote
    if @opened_quote
      closing_quote
    elsif column_start?
      @opened_quote = true
    else
      stray_quote
    end
  end

  def closing_quote
    following = @line[@pos + 1]
    if following.nil? || [',', "\r", "\n"].include?(following)
      @opened_quote = false
    elsif following == '"'
      @pos += 1 # correctly escaped
    else
      stray_quote
    end
  end

  def column_start?
    @last_comma_pos == -1 ? @pos.zero? : @line[@pos - 1] == ','
  end

  # the column runs to the next comma, quotes and all
  def stray_quote
    col_end = @line.index(',', @pos + 1) || (@line.size - 1)
    @columns << [@line[@last_comma_pos + 1, col_end - @last_comma_pos - 1], :stray_quote]
    @opened_quote = false
    @last_comma_pos = @pos = col_end
  end

  def separator
    return if @opened_quote

    @columns << [@line[@last_comma_pos + 1, @pos - @last_comma_pos - 1], :ok]
    @last_comma_pos = @pos
  end
end

def empty_column?(col)
  col.nil? ||
    col.empty? ||
    col.strip.empty? ||
    col == '""' ||
    col == '" "'
end

def parse_csv_row(file, lineno, number_of_lines)
  cnt = 1
  str = +''
  file.each do |line|
    cnt += 1
    next if cnt < lineno

    str << line
    number_of_lines -= 1
    break if number_of_lines.zero?
  end
  LineParser.new(str).parse
end

options = {
  all_columns: false
}
OptionParser.new do |opts|
  opts.banner = 'Usage: ' + File.basename(__FILE__) + ' [options] <csv file> <line number> [<number of lines>]'

  opts.on('-h', '--help', 'Prints this help') do
    puts opts
    exit
  end

  opts.on('-a', '--all', 'Display all columns') do
    options[:all_columns] = true
  end
end.parse!

lineno = ARGV[1].to_i
number_of_lines = (ARGV[2] || 1).to_i

raise 'no lineno specified' unless lineno.positive?

data = File.open(ARGV[0], 'rb') do |file|
  headers = strip_byte_order_mark(file.readline.strip).split(',')
  headers.zip(parse_csv_row(file, lineno, number_of_lines))
end

cnt = 0
data.each do |k, (v, status)|
  cnt += 1
  next if !options[:all_columns] && empty_column?(v)

  if status == :ok
    puts format('  %-3d %s: %s', cnt, k, v)
  else
    puts format('* %-3d (%s) %s: %s', cnt, status.to_s.gsub('_', ' '), k, v)
  end
end
