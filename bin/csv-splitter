#!/usr/bin/env ruby
# frozen_string_literal: true

require 'optparse'

options = {
  rows: 250_000,
  no_header: false
}
OptionParser.new do |opts|
  opts.banner = 'Usage: ' + File.basename(__FILE__) + ' [options] <csv file>'

  opts.on('-h', '--help', 'Prints this help') do
    puts opts
    exit
  end

  opts.on('-r', '--rows ROWS', Integer, 'Max number of rows per a CSV') do |v|
    raise OptionParser::InvalidArgument, "--rows must be positive (#{v})" unless v.positive?

    options[:rows] = v
  end

  opts.on('--no-header', 'CSV file has no header') do
    options[:no_header] = true
  end
end.parse!

file = ARGV[0] || raise('no CSV file specified')

require 'csv-utils'

def get_split_file_name(file, num_files, total_files)
  if file =~ /\.(?:csv|tsv)$/i
    file.sub(/\.(?:csv|tsv)$/i) { |m| ".part-#{num_files}-of-#{total_files}" + m }
  else
    file + ".part-#{num_files}"
  end
end

csv_options = CSVUtils::CSVOptions.new(file).to_csv_options.merge(liberal_parsing: true)
# a single column file has no separator to detect
csv_options[:col_sep] ||= ','

# one pass: parts are written under temporary names, then renamed once the number of parts is known
part_files = []
out = nil
num_rows = 0

CSV.open(file, 'rb', **CSVUtils::EncodingOptions.read(csv_options)) do |csv|
  headers = options[:no_header] ? nil : csv.shift

  while (row = csv.shift)
    if out.nil? || num_rows >= options[:rows]
      out&.close
      num_rows = 0
      part_files << "#{file}.part-#{part_files.size + 1}.tmp"
      out = CSV.open(part_files.last, 'wb', **CSVUtils::EncodingOptions.write(csv_options))
      out << headers if headers
    end

    out << row
    num_rows += 1
  end
ensure
  out&.close
end

part_files.each_with_index do |part_file, idx|
  File.rename(part_file, get_split_file_name(file, idx + 1, part_files.size))
end
