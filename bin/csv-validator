#!/usr/bin/env ruby
# frozen_string_literal: true

require 'csv'
begin
  require 'rchardet'
rescue LoadError
  warn 'gem install rchardet'
  exit 1
end

# checks copies, so the row's values keep their bytes for the messages and the correction file
def utf8?(str)
  str.dup.force_encoding('utf-8').valid_encoding?
end

def convert_to_utf8(str, current_encoding)
  return nil unless current_encoding

  converted = str.dup.force_encoding(current_encoding)
  return nil unless converted.valid_encoding?

  converted.encode('utf-8')
end

def detect_encoding(col)
  CharDet.detect(col)['encoding']
end

def strip_bom!(col)
  col.sub!("\xEF\xBB\xBF".b, '')
end

id_column_name = ARGV[1]
# read bytes as is; reading as UTF-8 would raise on the values this script looks for
csv = CSV.open(ARGV[0] || abort('Usage: csv-validator <csv file> [<id header>]'), 'rb:BINARY')
out = nil

begin
  headers = csv.shift || []
  strip_bom!(headers[0]) if headers[0]

  id_column_name ||= headers[0]
  unless headers.include?(id_column_name)
    warn("header #{id_column_name} not found in current set of headers")
    exit 1
  end

  id_column_num = headers.index(id_column_name)

  out_proc = proc do |row|
    out ||=
      begin
        out = CSV.open('utf8-correction.csv', 'wb')
        out << [id_column_name, 'Row', 'Col', 'Header', 'Value']
        out
      end

    out << row
  end

  csv_lineno = 1

  while (row = csv.shift)
    csv_lineno += 1

    warn "row(#{csv_lineno}): invalid number of columns, expected #{headers.size} got #{row.size}" unless row.size == headers.size

    row.each_with_index do |col, idx|
      next if col.nil? || utf8?(col)

      warn "row(#{csv_lineno}),col(#{idx + 1}) #{headers[idx]}: non UTF-8 characters found in #{col.inspect}"
      encoding = detect_encoding(col)
      if (col_utf8_encoded = convert_to_utf8(col, encoding))
        puts "row(#{csv_lineno}),col(#{idx + 1}) #{headers[idx]}: converted to UTF-8 from #{encoding} \"#{col_utf8_encoded}\""
        out_proc.call [row[id_column_num], csv_lineno, (idx + 1), headers[idx], col_utf8_encoded]
      else
        warn "row(#{csv_lineno}),col(#{idx + 1}) #{headers[idx]}: unknown character encoding"
      end
    end
  end
ensure
  csv.close
  out&.close
end
