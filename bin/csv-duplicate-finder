#!/usr/bin/env ruby
# frozen_string_literal: true

require 'optparse'

options = {
  ignore_columns: []
}
OptionParser.new do |opts|
  opts.banner = 'Usage: ' + File.basename(__FILE__) + ' [options] <csv file>'

  opts.on('-h', '--help', 'Prints this help') do
    puts opts
    exit
  end

  opts.on('-i', '--ignore HEADERS', 'Comma separated list of headers to ignore') do |v|
    options[:ignore_columns] = v.split(',')
  end
end.parse!

require 'digest/sha2'
require 'csv-utils'

file = ARGV[0] || raise('no CSV file specified')

# detect the separators, but read bytes as is, so values that aren't valid UTF-8 can still be compared
csv = CSVUtils::CSVIterator.new(file, CSVUtils::CSVOptions.new(file).to_csv_options.merge(encoding: 'BINARY'))

missing_headers = options[:ignore_columns] - csv.headers
raise("unknown headers #{missing_headers.join(', ')} in configured ignore headers") unless missing_headers.empty?

hashed_rows = {}

# rows are keyed by their line number in the file
csv.each do |row|
  options[:ignore_columns].each do |ignore_column|
    row[ignore_column] = ''
  end
  key = Digest::SHA256.hexdigest(row.values.to_csv)
  hashed_rows[key] ||= []
  hashed_rows[key] << row.lineno
end

duplicate_rows = {}

hashed_rows.reject! { |_key, row_numbers| row_numbers.size <= 1 }

hashed_rows.each do |key, row_numbers|
  hashed_rows[key] = {}
  row_numbers.each do |row_number|
    duplicate_rows[row_number] = key
    hashed_rows[key][row_number] = nil
  end
end

csv.each do |row|
  next unless (key = duplicate_rows[row.lineno])

  hashed_rows[key][row.lineno] = row
end

CSV.open('duplicates-' + File.basename(file), 'wb:BINARY') do |out|
  out << (%w[duplicate_key line_no] + csv.headers)

  hashed_rows.each do |key, rows|
    rows.each do |lineno, row|
      out << ([key, lineno] + row.values)
    end
  end
end
